# CMS RAW reprocessing validation: reruns the official processing of an Open
# Data record's RAW input and compares the output with the record's files.
# Parameters: README.md. Known REANA/CMS issues: docs/known-issues.md.
#
# No f-strings in the Snakefile or rules: Snakemake 7 can't tokenize them
# under Python 3.12 (reana-client). Plain Python modules (lib/, scripts/) can.
import json
import os
import sys

sys.path.insert(0, os.path.join(workflow.basedir, "lib"))
from config import load_settings

cfg = load_settings(config)

OPENDATACLIENT_CONTAINER = "docker://cernopendata/cernopendata-client:latest"
PYTHON_CONTAINER = "python:3.11-slim"
# dasgoclient, and ROOT from CMSSW_10_6 for haddnano.
CC7_CONTAINER = "docker://gitlab-registry.cern.ch/cms-cloud/cmssw-docker/cc7-cms"
BASE_CONTAINER = "docker://" + cfg.cmssw_image

JOB_INPUTS = "job_inputs.txt"
PROVENANCE = "reference_provenance.json"

# Hooks for rules/reana094_htcondor.smk, which overrides them for REANA 0.9.4
# (reana.cern.ch). The defaults are what REANA 0.95 needs.
STEP_CONTAINER = BASE_CONTAINER
STEP_RESOURCES = {
    "compute_backend": "htcondorcern",
    "htcondor_max_runtime": cfg.htcondor_max_runtime,
    "htcondor_request_memory": "6 GB",     # UL reco peaks at 4.7 GB
}
RUN_STEP_COMPAT_ARGS = ""
COMPAT_TARGETS = []

def first_step_input():
    """run_step.sh arguments overriding where the first step reads from."""
    return ""

def extra_step_inputs(step):
    """Extra inputs of a step's rule."""
    return []

def step_done(step):
    """What later rules wait for to use a step's output."""
    return ["results/" + step + "_{jobIndex}_confirm.txt"]

if cfg.reana_compat == "0.9":
    include: "rules/reana094_htcondor.smk"

include: "rules/inputs.smk"
include: "rules/cache.smk"
include: "rules/steps.smk"
if cfg.comparison_tier == "nanoaod":
    include: "rules/compare_nano.smk"
else:
    include: "rules/compare_aod.smk"
include: "rules/metrics.smk"


rule all:
    default_target: True
    input:
        "results/branch_comparison.csv",
        "results/plots",
        "results/metrics/metrics.csv",
        STEP_CLEANUPS,
        CACHE_TARGETS,
        COMPAT_TARGETS
